{
    "_comment": "BlankTB Portal Backend — FastAPI egg (verified Pelican-compatible)",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2025-11-09T00:00:00+00:00",
    "name": "BlankTB Portal Backend",
    "author": "Blank The Deer",
    "description": "A FastAPI-based backend for the BlankTB Portal — includes MongoDB, Discord webhooks, mail, and reCAPTCHA integration.",
    "features": null,
    "images": [
        "ghcr.io/pterodactyl/yolks:python_3.11"
    ],
    "file_denylist": [
        "*.pyc",
        "__pycache__"
    ],
    "startup": "source .venv/bin/activate && uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "config": {
        "files": "{}",
        "startup": "{ \"done\": \"Application startup complete.\" }",
        "stop": "CTRL+C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/bash\napt update -y\napt install -y git python3 python3-venv python3-pip\npython3 -m venv .venv\nsource .venv/bin/activate\ngit clone https://{{PAT}}@github.com/BlankTheDeer/gba.git --branch dev --single-branch backend_src\ncd backend_src/backend\npip install -r requirements.txt\ndeactivate\necho 'BlankTB Backend installed successfully.'",
            "container": "ghcr.io/pterodactyl/yolks:python_3.11",
            "entrypoint": "bash"
        }
    },
    "variables": [
        {
            "name": "PAT",
            "description": "GitHub Personal Access Token (read-only).",
            "env_variable": "PAT",
            "default_value": "",
            "user_viewable": false,
            "user_editable": true,
            "rules": "required|string"
        },
        {
            "name": "MONGO_URI",
            "description": "MongoDB connection string.",
            "env_variable": "MONGO_URI",
            "default_value": "mongodb://username:password@localhost:27017/blanktb_portal",
            "user_viewable": false,
            "user_editable": true,
            "rules": "required|string"
        },
        {
            "name": "JWT_SECRET",
            "description": "JWT secret key.",
            "env_variable": "JWT_SECRET",
            "default_value": "supersecretkey",
            "user_viewable": false,
            "user_editable": true,
            "rules": "required|string"
        },
        {
            "name": "RECAPTCHA_SECRET",
            "description": "Google reCAPTCHA secret key.",
            "env_variable": "RECAPTCHA_SECRET",
            "default_value": "",
            "user_viewable": false,
            "user_editable": true,
            "rules": "string"
        },
        {
            "name": "MAIL_SERVER",
            "description": "SMTP mail server address.",
            "env_variable": "MAIL_SERVER",
            "default_value": "smtp.gmail.com",
            "user_viewable": false,
            "user_editable": true,
            "rules": "string"
        },
        {
            "name": "MAIL_PORT",
            "description": "SMTP port.",
            "env_variable": "MAIL_PORT",
            "default_value": "587",
            "user_viewable": false,
            "user_editable": true,
            "rules": "integer"
        },
        {
            "name": "MAIL_USER",
            "description": "SMTP username.",
            "env_variable": "MAIL_USER",
            "default_value": "noreply@blanktb.net",
            "user_viewable": false,
            "user_editable": true,
            "rules": "string"
        },
        {
            "name": "MAIL_PASS",
            "description": "SMTP password or app token.",
            "env_variable": "MAIL_PASS",
            "default_value": "",
            "user_viewable": false,
            "user_editable": true,
